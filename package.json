{
  "name": "pi-orchestraitor",
  "version": "0.1.0",
  "description": "Personal Pi harness with bundled development skills, compact tools, Context7, Engram, and Orchestraitor.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "extensions/",
    "instructions/",
    "prompts/",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "skills/",
    "scripts/",
    "docs/",
    "licenses/"
  ],
  "pi": {
    "extensions": [
      "./extensions/compact-tools.ts",
      "./extensions/instructions.ts",
      "./extensions/mcp.ts",
      "./extensions/subagents.ts",
      "./extensions/status-ui.ts",
      "./extensions/skill-registry.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts/*.md"
    ],
    "themes": []
  },
  "scripts": {
    "bench": "node scripts/bench.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:mcp": "node --test tests/integration/mcp-live.test.mjs",
    "test:pretty": "node tests/helpers/pretty-isolation.mjs",
    "install:pi": "node scripts/install-pi.mjs",
    "test:personality": "node scripts/check-personality.mjs"
  },
  "config": {
    "piPretty": "npm:@heyhuynhgiabuu/pi-pretty@0.6.30"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  }
}
